### =========================================================
### 1. REGISTER PARTNER
### =========================================================

###
# @name registerPartner
POST http://localhost:3000/partners/register
Content-Type: application/json

{
  "name": "Partner Final",
  "email": "partner_final@test.com",
  "password": "123456",
  "company_name": "Final Company"
}

### =========================================================
### 2. LOGIN PARTNER
### =========================================================

###
# @name loginPartner
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "partner_final@test.com",
  "password": "123456"
}

###
@tokenPartner = {{loginPartner.response.body.token}}

### =========================================================
### 3. REGISTER CUSTOMER
### =========================================================

###
# @name registerCustomer
POST http://localhost:3000/customers/register
Content-Type: application/json

{
  "name": "Customer Final",
  "email": "customer_final@test.com",
  "password": "123456",
  "address": "Rua Teste",
  "phone": "11999999999"
}

### =========================================================
### 4. LOGIN CUSTOMER
### =========================================================

###
# @name loginCustomer
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "customer_final@test.com",
  "password": "123456"
}

###
@tokenCustomer = {{loginCustomer.response.body.token}}

### =========================================================
### 5. CREATE EVENT
### =========================================================

###
# @name createEvent
POST http://localhost:3000/partners/events
Content-Type: application/json
Authorization: Bearer {{tokenPartner}}

{
  "name": "Evento Final",
  "description": "Evento para fluxo final",
  "date": "2027-08-01T10:00:00Z",
  "location": "São Paulo"
}

###
@eventId = {{createEvent.response.body.id}}

### =========================================================
### 6. CREATE TICKETS
### =========================================================

###
# @name createTickets
POST http://localhost:3000/partners/events/{{eventId}}/tickets
Content-Type: application/json
Authorization: Bearer {{tokenPartner}}

{
  "num_tickets": 5,
  "price": 100
}

### =========================================================
### 7. LIST TICKETS NO BANCO
### Rode no MySQL antes da reserva:
### SELECT id, status FROM tickets ORDER BY id;
### Se criou tudo do zero, use [1,2] na reserva e [3,4] na compra
### =========================================================

### =========================================================
### 8. RESERVAR TICKETS (SUCESSO)
### =========================================================

###
# @name createReservation
POST http://localhost:3000/partners/events/reservations
Content-Type: application/json
Authorization: Bearer {{tokenCustomer}}

{
  "ticket_ids": [1, 2]
}

### =========================================================
### 9. COMPRAR OUTROS TICKETS (SUCESSO)
### =========================================================

###
# @name createPurchase
POST http://localhost:3000/partners/events/purchases
Content-Type: application/json
Authorization: Bearer {{tokenCustomer}}

{
  "ticket_ids": [3, 4],
  "card_token": "card_token_test"
}

###
@purchaseId = {{createPurchase.response.body.id}}

### =========================================================
### 10. CANCELAR COMPRA
### =========================================================

###
POST http://localhost:3000/partners/events/purchases/{{purchaseId}}/cancel
Authorization: Bearer {{tokenCustomer}}