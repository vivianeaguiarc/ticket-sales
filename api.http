### =========================================================
### Ticket Sales API — Fluxo feliz completo
###
### Pré-requisitos:
### 1. MySQL rodando (porta 3307 no host — docker compose up -d mysql)
### 2. Schema aplicado (db.sql via volume na primeira subida do MySQL)
### 3. API em execução: pnpm dev  OU  docker compose up -d
### 4. Extensão REST Client (VS Code / Cursor)
###
### Dica: para banco limpo, rode docker compose down -v antes de subir.
### Execute os blocos NA ORDEM (0 → 12).
### =========================================================

@baseUrl = http://localhost:3000

### =========================================================
### 0. HEALTH CHECK (sem autenticação)
### =========================================================

###
# @name healthCheck
GET {{baseUrl}}/health

###
# @name readinessCheck
GET {{baseUrl}}/ready

### =========================================================
### 1. CADASTRO DO PARCEIRO
### POST /partners/register — público — esperado: 201
### =========================================================

###
# @name registerPartner
POST {{baseUrl}}/partners/register
Content-Type: application/json

{
  "name": "Partner Portfolio",
  "email": "partner_portfolio@test.com",
  "password": "123456",
  "company_name": "Portfolio Events"
}

### =========================================================
### 2. LOGIN DO PARCEIRO
### POST /auth/login — público — esperado: 200 + token
### =========================================================

###
# @name loginPartner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "partner_portfolio@test.com",
  "password": "123456"
}

###
@tokenPartner = {{loginPartner.response.body.token}}

### =========================================================
### 3. CADASTRO DO CLIENTE
### POST /customers/register — público — esperado: 201
### =========================================================

###
# @name registerCustomer
POST {{baseUrl}}/customers/register
Content-Type: application/json

{
  "name": "Customer Portfolio",
  "email": "customer_portfolio@test.com",
  "password": "123456",
  "address": "Rua Teste, 100",
  "phone": "11999999999"
}

### =========================================================
### 4. LOGIN DO CLIENTE
### POST /auth/login — público — esperado: 200 + token
### =========================================================

###
# @name loginCustomer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "customer_portfolio@test.com",
  "password": "123456"
}

###
@tokenCustomer = {{loginCustomer.response.body.token}}

### =========================================================
### 5. CRIAR EVENTO (partner autenticado)
### POST /partners/events — esperado: 201
### =========================================================

###
# @name createEvent
POST {{baseUrl}}/partners/events
Content-Type: application/json
Authorization: Bearer {{tokenPartner}}

{
  "name": "Show Portfolio",
  "description": "Evento para demonstração do fluxo completo",
  "date": "2027-08-01T10:00:00.000Z",
  "location": "São Paulo"
}

###
@eventId = {{createEvent.response.body.id}}

### =========================================================
### 6. CRIAR TICKETS EM LOTE (partner autenticado)
### POST /partners/events/:eventId/tickets — esperado: 204
### =========================================================

###
# @name createTickets
POST {{baseUrl}}/partners/events/{{eventId}}/tickets
Content-Type: application/json
Authorization: Bearer {{tokenPartner}}

{
  "num_tickets": 5,
  "price": 100
}

### =========================================================
### 7. LISTAR TICKETS DO EVENTO
### GET /partners/events/:eventId/tickets — esperado: 200
### IDs dinâmicos usados nas etapas 9 e 10
### =========================================================

###
# @name listTickets
GET {{baseUrl}}/partners/events/{{eventId}}/tickets
Authorization: Bearer {{tokenPartner}}

###
@ticketId1 = {{listTickets.response.body.$[0].id}}
@ticketId2 = {{listTickets.response.body.$[1].id}}
@ticketId3 = {{listTickets.response.body.$[2].id}}
@ticketId4 = {{listTickets.response.body.$[3].id}}

### =========================================================
### 7.1 HISTÓRICO DO EVENTO (partner dono)
### GET /partners/events/:eventId/history — esperado: 200
### =========================================================

###
# @name eventHistory
GET {{baseUrl}}/partners/events/{{eventId}}/history
Authorization: Bearer {{tokenPartner}}

### =========================================================
### 8. VALIDAÇÃO NO MYSQL (opcional, antes de reservar/comprar)
### docker exec -it ticket-sales-db mysql -uroot -proot tickets
### =========================================================

# SELECT id, status, price FROM tickets WHERE event_id = {{eventId}} ORDER BY id;
# Esperado: 5 tickets com status `available`

### =========================================================
### 9. RESERVAR TICKETS (customer autenticado)
### POST /partners/events/reservations — esperado: 201
### Ciclo: available → reserved
### =========================================================

###
# @name createReservation
POST {{baseUrl}}/partners/events/reservations
Content-Type: application/json
Authorization: Bearer {{tokenCustomer}}

{
  "ticket_ids": [{{ticketId1}}, {{ticketId2}}]
}

### =========================================================
### 10. COMPRAR OUTROS TICKETS (customer autenticado)
### POST /partners/events/purchases — esperado: 201
### Ciclo: available → sold | card_token obrigatório
### =========================================================

###
# @name createPurchase
POST {{baseUrl}}/partners/events/purchases
Content-Type: application/json
Authorization: Bearer {{tokenCustomer}}

{
  "ticket_ids": [{{ticketId3}}, {{ticketId4}}],
  "card_token": "card_token_test_12345"
}

###
@purchaseId = {{createPurchase.response.body.id}}

### =========================================================
### 11. CANCELAR COMPRA
### POST /partners/events/purchases/:id/cancel — esperado: 200
### Ciclo: sold → available
### =========================================================

###
# @name cancelPurchase
POST {{baseUrl}}/partners/events/purchases/{{purchaseId}}/cancel
Authorization: Bearer {{tokenCustomer}}

### =========================================================
### 12. VALIDAÇÃO FINAL NO MYSQL
### =========================================================

# -- Tickets reservados (etapa 9)
# SELECT id, status FROM tickets WHERE id IN ({{ticketId1}}, {{ticketId2}});
# Após reserva: reserved | Após job (60s): available

# -- Tickets comprados e cancelados (etapas 10–11)
# SELECT id, status FROM tickets WHERE id IN ({{ticketId3}}, {{ticketId4}});
# Após compra: sold | Após cancelamento: available

# SELECT ticket_id, from_status, to_status, changed_at
# FROM ticket_status_history ORDER BY changed_at DESC LIMIT 20;

# SELECT id, ticket_id, status, expires_at
# FROM reservation_tickets ORDER BY id DESC LIMIT 10;

# SELECT id, status, total_amount FROM purchases ORDER BY id DESC LIMIT 5;

# SELECT action, entity_type, entity_id, created_at
# FROM audit_logs ORDER BY created_at DESC LIMIT 10;

### =========================================================
### ROTAS PÚBLICAS ADICIONAIS
### =========================================================

###
# @name listPublicEvents
GET {{baseUrl}}/events

###
# @name getPublicEvent
GET {{baseUrl}}/events/{{eventId}}

###
# @name listPartnerEvents
GET {{baseUrl}}/partners/events
Authorization: Bearer {{tokenPartner}}

### =========================================================
### DOCUMENTAÇÃO INTERATIVA
### Swagger UI: GET /docs
### =========================================================

###
# @name swaggerDocs
GET {{baseUrl}}/docs

### =========================================================
### CENÁRIOS DE ERRO (opcional — executar manualmente)
### =========================================================

### Login inválido — esperado: 401
# POST {{baseUrl}}/auth/login
# Content-Type: application/json
#
# {
#   "email": "invalido@test.com",
#   "password": "errado"
# }

### Rota protegida sem token — esperado: 401
# POST {{baseUrl}}/partners/events
# Content-Type: application/json
#
# {
#   "name": "Sem token"
# }

### Ticket inexistente na compra — esperado: 404
# POST {{baseUrl}}/partners/events/purchases
# Content-Type: application/json
# Authorization: Bearer {{tokenCustomer}}
#
# {
#   "ticket_ids": [99999],
#   "card_token": "x"
# }
