# Copie para .env e ajuste conforme o ambiente.
# Variáveis lidas por src/config/env.ts

# --- Ambiente ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Banco de dados (MySQL) ---
# Local com MySQL no Docker: DB_HOST=localhost, DB_PORT=3307
# Docker Compose (API no container): DB_HOST=mysql, DB_PORT=3306
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=tickets

# Porta exposta do MySQL no host (apenas docker-compose.yml)
DB_HOST_PORT=3307

# --- Autenticação ---
# Em NODE_ENV=production o startup falha se JWT_SECRET for o valor padrão.
JWT_SECRET=your_secret_key

# --- Segurança HTTP (planejado — ainda não implementado no código) ---
# CORS_ORIGIN=http://localhost:3000
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
