# Copie para .env e ajuste conforme o ambiente.
#
# --- Desenvolvimento local (pnpm dev + MySQL no Docker ou local) ---
# DB_HOST=localhost
# DB_PORT=3307
#
# --- Docker Compose (API no container) ---
# DB_HOST=mysql
# DB_PORT=3306
# (já configurado em docker-compose.yml para o serviço api)
#
# --- Produção (Render, Railway, etc.) ---
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# DB_HOST=<host do MySQL gerenciado>
# DB_PORT=3306
# DB_USER=<usuario>
# DB_PASSWORD=<senha forte>
# DB_NAME=tickets
# JWT_SECRET=<segredo forte e único>

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=tickets

# Porta exposta do MySQL no host (apenas docker-compose)
DB_HOST_PORT=3307

JWT_SECRET=your_secret_key
