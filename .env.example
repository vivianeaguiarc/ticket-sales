# Copie para .env e ajuste conforme o ambiente.
#
# Modo local (API com pnpm dev + MySQL no Docker ou local):
#   DB_HOST=localhost
#   DB_PORT=3307
#
# Modo Docker Compose (API no container):
#   DB_HOST=mysql
#   DB_PORT=3306
#   (já configurado em docker-compose.yml para o serviço api)

PORT=3000

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=tickets

# Porta exposta do MySQL no host (apenas docker-compose)
DB_HOST_PORT=3307

JWT_SECRET=your_secret_key
